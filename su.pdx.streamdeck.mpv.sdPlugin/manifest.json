{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "su.pdx.streamdeck.mpv",
  "Name": "mpv",
  "Version": "0.1.0.0",
  "Author": "Jeff Sandberg",
  "Description": "Send commands to mpv and show live playback state over mpv's JSON IPC.",
  "Icon": "imgs/plugin",
  "Category": "mpv",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/streamdeck-mpv",
  "CodePathMac": "bin/streamdeck-mpv",
  "CodePathWin": "bin/streamdeck-mpv.exe",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "su.pdx.streamdeck.mpv.command",
      "Name": "Command",
      "Icon": "imgs/action-command",
      "Tooltip": "Send a command to mpv",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/command.html",
      "States": [
        {
          "Image": "imgs/key-command"
        }
      ]
    },
    {
      "UUID": "su.pdx.streamdeck.mpv.display",
      "Name": "Display",
      "Icon": "imgs/action-display",
      "Tooltip": "Show live mpv properties",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/display.html",
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/key-display",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    }
  ]
}